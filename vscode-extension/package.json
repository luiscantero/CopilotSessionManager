{
  "name": "copilot-session-manager",
  "displayName": "Session Manager for GitHub Copilot",
  "description": "Search, resume and clean up your GitHub Copilot CLI sessions and VS Code chats. Full-text, local and fast.",
  "version": "0.3.0",
  "publisher": "luiscantero",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/luiscantero/CopilotSessionSearch"
  },
  "bugs": {
    "url": "https://github.com/luiscantero/CopilotSessionSearch/issues"
  },
  "homepage": "https://github.com/luiscantero/CopilotSessionSearch#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "copilot",
    "copilot-cli",
    "github-copilot",
    "chat",
    "chat-history",
    "session",
    "sessions",
    "history",
    "search",
    "full-text",
    "resume",
    "agent",
    "conversation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onWebviewPanel:copilotSessionManager"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copilotSessionManager.search",
        "title": "Search Sessions…",
        "category": "Session Manager for GitHub Copilot",
        "icon": "$(search)"
      },
      {
        "command": "copilotSessionManager.open",
        "title": "Open Session Browser",
        "category": "Session Manager for GitHub Copilot",
        "icon": "$(history)"
      },
      {
        "command": "copilotSessionManager.showLog",
        "title": "Show Log",
        "category": "Session Manager for GitHub Copilot"
      }
    ],
    "keybindings": [
      {
        "command": "copilotSessionManager.search",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "Session Manager for GitHub Copilot",
      "properties": {
        "copilotSessionManager.copilotCommand": {
          "type": "string",
          "default": "copilot",
          "markdownDescription": "Command used to start the GitHub Copilot CLI when resuming a session in the terminal. `--resume=<id>` is appended."
        },
        "copilotSessionManager.quickPick.defaultAction": {
          "type": "string",
          "enum": [
            "showConversation",
            "resume",
            "openInChat"
          ],
          "enumDescriptions": [
            "Show the conversation in the session browser.",
            "Resume Copilot CLI sessions in a terminal; VS Code chats open in the Chat view.",
            "Open the session in VS Code's Chat view."
          ],
          "default": "showConversation",
          "description": "What happens when you press Enter on a session in the quick search."
        },
        "copilotSessionManager.sidecarPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a custom build of the search backend (copilot-session-manager-sidecar). Leave empty to use the bundled one."
        }
      }
    }
  },
  "scripts": {
    "build:sidecar": "node scripts/build.mjs --sidecar",
    "build:assets": "node scripts/build.mjs --assets",
    "build": "node scripts/build.mjs && tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
